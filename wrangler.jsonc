{
  // Cloudflare Worker that serves the static site in `site/` and handles the
  // contact form at POST /api/contact. Deploy with: wrangler deploy
  "name": "terrier-adtech-website-2",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    // Everything in site/ is served as a static asset. Requests that don't
    // match a file (e.g. /api/contact) fall through to the Worker in main.
    "directory": "./site",
    "binding": "ASSETS",
    // Run the Worker BEFORE serving static assets. Without this, a request
    // that matches a file (e.g. the apex hitting "/" -> index.html) is served
    // directly and the Worker never runs — so the apex -> www redirect in
    // worker/index.js would be skipped. The Worker still falls back to
    // env.ASSETS.fetch() for normal page loads.
    "run_worker_first": true
  }
}
